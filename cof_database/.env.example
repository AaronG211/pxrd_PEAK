# Supabase project endpoint (same value for server and Vite client)
SUPABASE_URL=https://YOUR_PROJECT_REF.supabase.co
VITE_SUPABASE_URL=https://YOUR_PROJECT_REF.supabase.co

# Server/local importer only. Never expose this value to browser code.
SUPABASE_SECRET_KEY=sb_secret_YOUR_SECRET_KEY

# Public browser key. A legacy anon JWT also works while Supabase supports it.
VITE_SUPABASE_ANON_KEY=sb_publishable_YOUR_PUBLISHABLE_KEY
